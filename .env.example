# QQ 开放平台：机器人设置 -> 开发设置
QQ_APP_ID=
QQ_APP_SECRET=

# 中国科大大模型公共服务平台
USTC_LLM_API_KEY=
USTC_LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1
USTC_LLM_MODEL=deepseek-v4-flash-ascend
CHAT_SYSTEM_PROMPT="请保持回答自然、友善，并优先使用中文。"
CHAT_HISTORY_TURNS=8

# 水鱼账号开发者控制台：https://auth.diving-fish.com/console
DIVINGFISH_CLIENT_ID=
DIVINGFISH_CLIENT_SECRET=

# 可选落雪只读 OAuth。生产需登记 HTTPS 回调，并将路径反代至本地监听端口。
LXNS_CLIENT_ID=
LXNS_CLIENT_SECRET=
LXNS_REDIRECT_URI=
LXNS_CALLBACK_PORT=8632

# 可选
BOT_OWNER_OPENIDS=
LOG_LEVEL=INFO
