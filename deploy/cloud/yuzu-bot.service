[Unit]
Description=Yuzu QQ Bot (official QQ Open Platform)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=yuzu-bot
Group=yuzu-bot
WorkingDirectory=/opt/yuzu-bot/current
EnvironmentFile=/etc/yuzu-bot/env
ExecStart=/opt/yuzu-bot/current/.venv/bin/maimai-bot
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/yuzu-bot
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
